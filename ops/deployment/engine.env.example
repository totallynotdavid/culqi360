# Absolute path on the Dokploy host. The directory must contain contacts.sqlite
# and be writable by uid 10001. The engine creates leads.sqlite and
# ingest.sqlite.
ENGINE_DATA_PATH=/srv/crm/engine

# Include one independent key per application deployment.
ENGINE_HMAC_KEYS_JSON={"master":"replace-me","member-a":"replace-me","member-b":"replace-me"}
ENGINE_RATE_LIMIT_PER_KEY=600
ENGINE_MAX_LIMIT=100
