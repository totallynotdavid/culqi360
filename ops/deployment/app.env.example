# These values must be unique for every branch deployment.
DEPLOYMENT_NAME=master
APP_DOMAIN=domain.com
APP_DATA_PATH=/srv/culqi360/master

NODE_ENV=production
APP_PUBLIC_ORIGIN=https://culqi360.example.com
TRUSTED_PROXY=true
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=
RECOVERY_CODE_PEPPER=
INSTALLATION_PASSWORD=

ENGINE_HMAC_KEY_ID=master
ENGINE_HMAC_SECRET=
ENGINE_TIMEOUT_MS=5000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
