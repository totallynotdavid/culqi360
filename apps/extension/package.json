{
  "name": "@crm/extension",
  "version": "0.0.0",
  "private": true,
  "description": "CRM browser extension for resilient VoIP session state and recording sync",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "tsc --noEmit",
    "test:integration": "bun run build && playwright test",
    "test:integration:headed": "bun run build && playwright test --headed",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@crm/contracts": "workspace:*",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.1.37",
    "@wxt-dev/module-solid": "^1.1.4",
    "typescript": "^5.9.3",
    "wxt": "^0.20.18"
  }
}
