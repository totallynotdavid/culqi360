{
  "name": "@crm/extension",
  "version": "0.0.0",
  "private": true,
  "description": "CRM browser extension for resilient VoIP session state and recording sync",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:test": "CRM_FAKE_TAB_CAPTURE=1 wxt build --mode test",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test:integration": "bun run build:test && playwright test",
    "test:integration:headed": "bun run build:test && playwright test --headed",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@crm/contracts": "workspace:*",
    "@solidjs/web": "^2.0.0-rc.17",
    "solid-js": "^2.0.0-rc.17"
  },
  "devDependencies": {
    "@crm/tsconfig": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@solidjs/vite-plugin": "^3.0.0-next.52",
    "@types/chrome": "^0.3.7",
    "wxt": "^0.21.5"
  }
}
