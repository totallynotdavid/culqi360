{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "jsPlugins": ["eslint-plugin-solid"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "prefer-tag-over-role": "off",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-return": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectOk",
          "expectErr",
          "expectErrCode",
          "expectLeadMetadata",
          "expectLeadAssignment",
          "expectLeadStatus",
          "expectInvalidLimit"
        ]
      }
    ],
    // identifier usage is important
    "solid/jsx-no-duplicate-props": 2,
    "solid/jsx-no-undef": [2, { "typescriptEnabled": true }],
    "solid/jsx-uses-vars": 2,
    // security problems
    "solid/no-innerhtml": 2,
    "solid/jsx-no-script-url": 2,
    // reactivity
    "solid/components-return-once": 1,
    "solid/no-destructure": 2,
    "solid/prefer-for": 2,
    "solid/reactivity": 0,
    "solid/event-handlers": 1,
    // these rules are mostly style suggestions
    "solid/imports": 0,
    "solid/style-prop": 1,
    "solid/no-react-deps": 1,
    "solid/no-react-specific-props": 1,
    "solid/self-closing-comp": 1
  }
}
