{
  "name": "@crm/web",
  "type": "module",
  "scripts": {
    "dev": "bun run wait:db && bun run migrate && bun run seed && bun run dev:server",
    "wait:db": "until mise x postgres -- pg_isready -h localhost -p 5432 -U postgres -q; do echo 'waiting for postgres...'; sleep 0.3; done",
    "dev:server": "bun --env-file=../../.env --bun vite --configLoader native --config vite.config.ts",
    "dev:preview-server": "bun --bun vite --configLoader native --config vite.config.ts",
    "build": "bun --env-file=../../.env.production --bun vite build --configLoader native --config vite.config.ts",
    "build:container": "bun --bun vite build --configLoader native --config vite.config.ts",
    "start": "bun run server.ts",
    "worker:maintenance": "bun --env-file=../../.env src/workers/maintenance-runner.ts",
    "worker:maintenance:prod": "bun src/workers/maintenance-runner.ts",
    "lint": "oxlint -c .oxlintrc.json --type-aware --tsconfig tsconfig.json --deny-warnings src tests",
    "check:types": "bun x tsc --noEmit",
    "check": "bun run check:types && bun run lint",
    "test": "bun --bun --env-file=../../.env.test vitest run --project unit --project contract --project integration --project journey",
    "test:unit": "bun --bun --env-file=../../.env.test vitest run --project unit",
    "test:contract": "bun --bun --env-file=../../.env.test vitest run --project contract",
    "test:integration": "bun --bun --env-file=../../.env.test vitest run --project integration",
    "test:journey": "bun --bun --env-file=../../.env.test vitest run --project journey",
    "test:e2e": "bun --bun --env-file=../../.env.test playwright test",
    "test:e2e:headed": "bun --bun --env-file=../../.env.test playwright test --headed",
    "test:e2e:ui": "bun --bun --env-file=../../.env.test playwright test --ui",
    "test:perf": "bun --env-file=../../.env.test vitest bench --run --config vitest.bench.config.ts",
    "migrate": "bun --env-file=../../.env src/server/platform/database/migrate-cli.ts",
    "migrate:test": "bun --env-file=../../.env.test src/server/platform/database/migrate-cli.ts",
    "migrate:prod": "bun src/server/platform/database/migrate-cli.ts",
    "seed": "bun --env-file=../../.env src/server/platform/database/seed.ts",
    "seed:test": "bun --env-file=../../.env.test src/server/platform/database/seed.ts",
    "provision:prod": "bun src/server/platform/database/seed.ts"
  },
  "dependencies": {
    "@crm/contracts": "workspace:*",
    "@crm/email-composer": "workspace:*",
    "@crm/images": "workspace:*",
    "@crm/message-channels": "workspace:*",
    "@crm/solid-motion": "workspace:*",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/aleo": "^5.3.0",
    "@fontsource/host-grotesk": "^5.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@sentry/browser": "^10.70.0",
    "@sentry/bun": "^10.69.0",
    "@simplewebauthn/server": "^13.3.1",
    "@solid-primitives/resize-observer": "^4.0.0-next.3",
    "@solidjs/meta": "^1.0.0-next.2",
    "@solidjs/router": "^2.0.0-next.17",
    "@solidjs/web": "^2.0.0-rc.1",
    "arctic": "^3.7.0",
    "clsx": "^2.1.1",
    "eventsource-parser": "^4.0.0",
    "filesystem-routing": "^0.2.1",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "solid-js": "^2.0.0-rc.1",
    "three": "^0.185.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.2.0",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.2.0",
    "@solidjs/vite-plugin": "^3.0.0-next.31",
    "@types/mdx": "^2.0.13",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.4",
    "eslint-plugin-solid": "^0.14.5",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "rolldown": "^1.2.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "seroval": "^1.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.4"
  }
}
