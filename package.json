{
  "name": "one-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/codegen"
  ],
  "scripts": {
    "dev": "bun run --parallel --no-exit-on-error dev:infra dev:engine dev:web dev:worker",
    "dev:infra": "mise x postgres -- postgres -D .pgdata -k /tmp",
    "dev:infra:setup": "mise x postgres -- initdb -D .pgdata -U postgres --auth=trust && mise x postgres -- pg_ctl -D .pgdata -o \"-k /tmp\" -l .pgdata/server.log start && mise x postgres -- createdb -h /tmp -U postgres crm && mise x postgres -- pg_ctl -D .pgdata stop",
    "dev:engine": "cargo run -p engine --bin engine",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/web worker:maintenance",
    "preview": "bun --cwd apps/web --env-file=../../.env tools/preview/cli.ts",
    "pipeline:engine": "cargo run -p pipeline --",
    "pipeline:refresh": "bun run pipeline:engine refresh --slice 100k",
    "pipeline:fixture": "bun run pipeline:engine refresh --config crates/pipeline/data/fixture/pipeline.toml --slice 10k",
    "pipeline:refresh:10k": "bun run pipeline:engine refresh --slice 10k",
    "pipeline:refresh:100k": "bun run pipeline:engine refresh --slice 100k",
    "pipeline:verify-manifest": "bun run pipeline:engine verify-manifest --allow-missing-optional",
    "pipeline:normalize-sample": "bun run pipeline:engine validate --profile quick --allow-missing-optional",
    "db:reset": "bun run --cwd apps/web db:reset",
    "clean:db": "shx rm -rf .pgdata",
    "clean:modules": "shx rm -rf node_modules 'apps/*/node_modules' 'packages/*/node_modules'",
    "clean": "bun run clean:db && bun run clean:modules",
    "refs:fetch": "bun run --cwd packages/fetch-refs fetch",
    "test:extension:integration": "bun run --cwd apps/extension test:integration"
  },
  "devDependencies": {
    "@crm/tsconfig": "workspace:*",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "agent-browser": "^0.39.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
