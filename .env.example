# Secrets

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Generate separately with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

RECOVERY_CODE_PEPPER=

# Must match a key in ENGINE_HMAC_KEYS_JSON.
ENGINE_HMAC_KEY_ID=web

# Generate with: openssl rand -hex 32
ENGINE_HMAC_SECRET=

# Map ENGINE_HMAC_KEY_ID to the same secret.
ENGINE_HMAC_KEYS_JSON='{"web":"replace-with-hex-secret"}'

# Web

NODE_ENV=development
INSTALLATION_PASSWORD=
TRUSTED_PROXY=false
APP_PUBLIC_ORIGIN=http://localhost:3000
WEB_UPLOADS_ROOT=.local-storage/documents
# WEB_DB_URL=postgres://postgres@localhost:5432/crm

# Engine

ENGINE_HOST=127.0.0.1
ENGINE_PORT=3001
ENGINE_CONNECT_MODE=local
ENGINE_URL=http://127.0.0.1:3001
ENGINE_TIMEOUT_MS=5000
ENGINE_CONTACTS_DB_PATH=crates/engine/data/contacts.sqlite
ENGINE_LEADS_DB_PATH=crates/engine/data/leads.sqlite
ENGINE_RATE_LIMIT_PER_KEY=600
# ENGINE_MAX_LIMIT=100
# ENGINE_HMAC_MAX_SKEW_SECS=60

# Enables the /ingest-uploads and /ingest-jobs routes and switches
# contacts.sqlite to WAL at startup.
# ENGINE_INGEST_ENABLED=true
# ENGINE_INGEST_JOB_DB_PATH=crates/engine/data/ingest.sqlite

# Leave CPU capacity for search while ingest is running.
# ENGINE_INGEST_WORKERS=4
# ENGINE_INGEST_BATCH_SIZE=5000

# Per-file upload limit.
# ENGINE_INGEST_MAX_UPLOAD_BYTES=2147483648
# ENGINE_INGEST_MAX_ROWS=10000000
# ENGINE_INGEST_MAX_QUEUED_UPLOADS=8

# Extension

# Generate one Ed25519 key pair per environment:
# openssl genpkey -algorithm Ed25519 -out extension-handoff-private.pem
#
# Private key, PKCS#8 DER encoded as base64:
# openssl pkcs8 -topk8 -nocrypt -in extension-handoff-private.pem -outform DER | base64 -w0
#
# Public key, SPKI DER encoded as base64:
# openssl pkey -in extension-handoff-private.pem -pubout -outform DER | base64 -w0
#
# Delete the PEM after storing the private key securely.
EXTENSION_EXPECTED_ORIGIN=http://localhost:3000
EXTENSION_HANDOFF_PRIVATE_KEY_PKCS8_BASE64=
EXTENSION_HANDOFF_PUBLIC_KEY_SPKI_BASE64=

# Integrations

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Notifications

# Omit a channel to disable it.
NOTIFICATION_ROUTES=email:resend,whatsapp:kapso
RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp: Kapso

KAPSO_API_KEY=
KAPSO_WHATSAPP_PHONE_NUMBER_ID=
# KAPSO_META_GRAPH_VERSION=v24.0

# WhatsApp: Meta Cloud direct

# Used only when NOTIFICATION_ROUTES includes whatsapp:whatsapp_cloud.
# Meta Business Settings > Users > System Users: generate a permanent token with
# whatsapp_business_management and whatsapp_business_messaging permissions.
WHATSAPP_CLOUD_ACCESS_TOKEN=
# Meta App Dashboard > WhatsApp > API Setup: copy the Phone number ID.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_GRAPH_VERSION=v24.0

# WhatsApp webhooks

# Generate with: openssl rand -base64 32
# Use the same value as the webhook verification token: https://<public-origin>/api/webhooks/whatsapp.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

KAPSO_WEBHOOK_SECRET=

# Observability

# LOG_LEVEL=info
# LOG_FORMAT=json

SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_BROWSER_TRACES_SAMPLE_RATE=0.1
# SENTRY_BROWSER_REPLAY_SESSION_SAMPLE_RATE=0.05
# SENTRY_BROWSER_REPLAY_ON_ERROR_SAMPLE_RATE=1.0

# Source-map upload at build time only.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
